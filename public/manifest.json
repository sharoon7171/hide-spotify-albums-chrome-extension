{
  "manifest_version": 3,
  "name": "Hide Albums in Spotify",
  "version": "1.0.0",
  "description": "Hide albums from Home, Artist, Search, and carousels on open.spotify.com. Unhide from any album page. Sign in to sync with Hide Albums in Spicetify.",

  "key": "",

  "permissions": ["storage"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],

  "action": {
    "default_title": "Hide Albums in Spotify"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com;"
  }
}
