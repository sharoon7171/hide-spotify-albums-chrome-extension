rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAlbum() {
      return request.resource.data.keys().hasOnly(['updatedAt', 'url', 'title'])
        && request.resource.data.updatedAt is number
        && (!('url' in request.resource.data) || request.resource.data.url is string)
        && (!('title' in request.resource.data) || request.resource.data.title is string);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      match /savedAlbums/{albumId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAlbum();
        allow delete: if isOwner(uid);
      }
    }
  }
}
