{
  "manifest_version": 3,
  "name": "Spotify Customization",
  "version": "1.0.0",
  "description": "Hide albums on open.spotify.com using stored album URLs from the in-player Hide control.",
  "permissions": ["storage"],
  "host_permissions": ["https://open.spotify.com/*"],
  "action": {
    "default_title": "Spotify Customization — open options"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
