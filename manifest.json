{
  "manifest_version": 3,
  "name": "Spotify Customization",
  "version": "1.0.0",
  "description": "Hide albums on open.spotify.com using stored album URLs from the in-player Hide control.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://open.spotify.com/*"],
  "action": {
    "default_title": "Spotify Customization — open options"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
